#!/usr/bin/env bash
# Switch the colour palette of i3, polybar, rofi, alacritty, dunst, the lock
# screen and the bar scripts (fish follows the terminal colours).
#
#   theme              pick a palette in rofi
#   theme <name>       apply themes/<name>.conf
#   theme --list
#   theme --no-reload <name>   only write the files (used by install.sh)
#
# Palettes live in themes/*.conf. Everything this script writes is generated and
# git-ignored: edit the palette, not the generated files.

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
RELOAD=1

[[ $1 == --no-reload ]] && { RELOAD=0; shift; }
if [[ $1 == --list ]]; then
	for f in "$ROOT"/themes/*.conf; do basename "$f" .conf; done
	exit 0
fi

name=$1
if [[ -z $name ]]; then
	name=$("$0" --list | rofi -dmenu -i -p "Theme" -l 8) || exit 0
fi
palette="$ROOT/themes/$name.conf"
[[ -f $palette ]] || { echo "no such theme: $name (see: ${0##*/} --list)" >&2; exit 1; }

# shellcheck disable=SC1090
source "$palette"
for key in BG BG_ALT FG FG_DIM ACCENT SELECTION BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE ORANGE; do
	[[ ${!key} =~ ^#[0-9a-fA-F]{6}$ ]] || { echo "$palette: $key is missing or not #rrggbb" >&2; exit 1; }
done

HEAD="generated by i3/scripts/theme from themes/$name.conf - do not edit"

cat >"$ROOT/i3/theme.env" <<END
# $HEAD
THEME=$name
BG=$BG BG_ALT=$BG_ALT FG=$FG FG_DIM=$FG_DIM ACCENT=$ACCENT BLACK=$BLACK
RED=$RED GREEN=$GREEN YELLOW=$YELLOW BLUE=$BLUE MAGENTA=$MAGENTA CYAN=$CYAN
END

cat >"$ROOT/i3/config.d/00_colors.conf" <<END
# $HEAD
set \$i3_cl_col_bg   $BG
set \$i3_cl_col_fg   $FG
set \$i3_cl_col_afoc $ACCENT
set \$i3_cl_col_ufoc $BG_ALT
set \$i3_cl_col_urgt $MAGENTA
set \$i3_cl_col_phol $BG
END

cat >"$ROOT/polybar/colors.ini" <<END
; $HEAD
[color]
BACKGROUND = $BG
FOREGROUND = $FG
ALTBACKGROUND = $BG_ALT
ALTFOREGROUND = $FG_DIM
ACCENT = $ACCENT

BLACK = $BG
RED = $RED
GREEN = $GREEN
YELLOW = $YELLOW
BLUE = $BLUE
MAGENTA = $MAGENTA
CYAN = $CYAN
WHITE = $WHITE
ALTBLACK = $BLACK
ALTRED = $RED
ALTGREEN = $GREEN
ALTYELLOW = $YELLOW
ALTBLUE = $BLUE
ALTMAGENTA = $MAGENTA
ALTCYAN = $CYAN
ALTWHITE = $FG

; labels that need a literal colour inside a %{F} tag
[generated]
network = %{A1:nm-connection-editor:}%{F$BLUE}󰁆%{F-} %downspeed% %{F$GREEN}󰁞%{F-} %upspeed%%{A}
END

cat >"$ROOT/rofi/shared/colors.rasi" <<END
/* $HEAD */
* {
    background:     $BG;
    background-alt: $BG_ALT;
    foreground:     $FG;
    selected:       $ACCENT;
    active:         $GREEN;
    urgent:         $RED;
}
END

cat >"$ROOT/alacritty/colors.toml" <<END
# $HEAD
[colors.primary]
background = '$BG'
foreground = '$FG'

[colors.cursor]
text = '$BG'
cursor = '$FG'

[colors.vi_mode_cursor]
text = '$BG'
cursor = '$FG'

[colors.search]
matches = { foreground = '$BG', background = '$ORANGE' }
focused_match = { foreground = '$BG', background = '$BLUE' }

[colors.hints]
start = { foreground = '$BG', background = '$YELLOW' }
end = { foreground = '$BG', background = '$WHITE' }

[colors.selection]
text = '$FG'
background = '$SELECTION'

[colors.normal]
black =   '$BG'
red =     '$RED'
green =   '$GREEN'
yellow =  '$YELLOW'
blue =    '$BLUE'
magenta = '$MAGENTA'
cyan =    '$CYAN'
white =   '$WHITE'

[colors.bright]
black =   '$BLACK'
red =     '$RED'
green =   '$GREEN'
yellow =  '$YELLOW'
blue =    '$BLUE'
magenta = '$MAGENTA'
cyan =    '$CYAN'
white =   '$FG'

[bell]
color = '$FG'
END

mkdir -p "$ROOT/dunst/dunstrc.d"
cat >"$ROOT/dunst/dunstrc.d/colors.conf" <<END
# $HEAD
[urgency_low]
background = "$BG"
foreground = "$FG"
frame_color = "$BLACK"

[urgency_normal]
background = "$BG"
foreground = "$FG"
frame_color = "$ACCENT"

[urgency_critical]
background = "$BG"
foreground = "$RED"
frame_color = "$RED"
END

((RELOAD)) || exit 0

i3-msg -q reload
~/.config/i3/scripts/wallpaper
touch -c "$ROOT/alacritty/alacritty.toml"      # nudges alacritty's live reload
dunstctl reload 2>/dev/null
(setsid ~/.config/i3/scripts/i3_bar >/dev/null 2>&1 &)
notify-send -t 2500 "Theme" "$name"
