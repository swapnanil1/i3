#!/usr/bin/env bash
# Switch the colour palette of everything listed in themes/targets.conf.
#
#   theme                      pick a palette in rofi
#   theme <name>               apply themes/palettes/<name>.conf
#   theme --list
#   theme --no-reload <name>   only write the files (used by install.sh)
#
#   themes/palettes/*.conf   one palette per file: KEY=#rrggbb
#   themes/templates/*       one colour file per tool, with ${KEY} placeholders
#   themes/targets.conf      which template goes where, and how to reload it
#
# Everything written is generated and git-ignored: edit palettes and templates.

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../.." && pwd)"
KEYS=(BG BG_ALT FG FG_DIM ACCENT SELECTION BLACK RED GREEN YELLOW BLUE MAGENTA CYAN WHITE ORANGE)
RELOAD=1

[[ $1 == --no-reload ]] && { RELOAD=0; shift; }
if [[ $1 == --list ]]; then
	for f in "$ROOT"/themes/palettes/*.conf; do basename "$f" .conf; done
	exit 0
fi

THEME=$1
if [[ -z $THEME ]]; then
	THEME=$("$0" --list | rofi -dmenu -i -p "Theme" -l 8) || exit 0
fi
palette="$ROOT/themes/palettes/$THEME.conf"
[[ -f $palette ]] || { echo "no such theme: $THEME (see: ${0##*/} --list)" >&2; exit 1; }

# Palettes are data, not scripts: accept KEY=#rrggbb lines and nothing else
while IFS='=' read -r key value; do
	[[ $key =~ ^[A-Z_]+$ && $value =~ ^#[0-9a-fA-F]{6}$ ]] && export "$key=$value"
done <"$palette"
for key in "${KEYS[@]}"; do
	[[ -n ${!key} ]] || { echo "$palette: $key is missing or not #rrggbb" >&2; exit 1; }
done
export THEME THEME_HEADER="generated by i3/scripts/theme from themes/palettes/$THEME.conf - do not edit"

# Only these names are substituted, so a template may use any other $variable
vars=$(printf '${%s} ' "${KEYS[@]}" THEME THEME_HEADER)

reloads=()
while IFS='|' read -r template target reload; do
	template=${template// /}; target=${target// /}
	[[ -z $template || $template == \#* ]] && continue
	mkdir -p "$(dirname "$ROOT/$target")"
	envsubst "$vars" <"$ROOT/themes/templates/$template" >"$ROOT/$target"
	reload=$(sed 's/^ *//; s/ *$//' <<<"$reload")
	[[ -n $reload ]] && reloads+=("$reload")
done <"$ROOT/themes/targets.conf"

((RELOAD)) || exit 0
for cmd in "${reloads[@]}"; do
	eval "$cmd" >/dev/null 2>&1
done
notify-send -t 2500 "Theme" "$THEME"
