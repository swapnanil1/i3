#!/usr/bin/env bash
# Put every connected output on its native resolution at the highest refresh
# rate it offers. Output names differ between the amdgpu and modesetting
# drivers and between ports, so nothing is hardcoded.

xrandr --query | awk '
	/ connected/ { out = $1; next }
	/^[A-Za-z]/  { out = ""; next }
	out != "" && /\+/ {
		# the "+" marks the preferred (native) mode; take its fastest rate
		mode = $1; best = 0
		for (i = 2; i <= NF; i++) {
			rate = $i; gsub(/[*+]/, "", rate)
			if (rate + 0 > best) best = rate + 0
		}
		printf "%s %s %s\n", out, mode, best
		out = ""
	}
' | while read -r output mode rate; do
	xrandr --output "$output" --mode "$mode" --rate "$rate"
done
