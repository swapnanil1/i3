#!/usr/bin/env bash

# Nerd Font icons: lock, logout, sleep, restart, power
options=(
	$'  Lock'
	$'\U000f0343  Logout'
	$'\U000f04b2  Suspend'
	$'\U000f0709  Reboot'
	$'  Shutdown'
)

choice=$(printf '%s\n' "${options[@]}" | rofi -dmenu -i -p "Power" -l "${#options[@]}")

case "$choice" in
	*Lock)     ~/.config/i3/scripts/lock-now ;;
	*Logout)   ~/.config/i3/scripts/sound --wait logout; systemctl --user stop i3-session.target; i3-msg exit ;;
	*Suspend)  systemctl suspend ;;
	*Reboot)   ~/.config/i3/scripts/sound --wait logout; systemctl reboot ;;
	*Shutdown) ~/.config/i3/scripts/sound --wait logout; systemctl poweroff ;;
esac
